# ---------------------------------------------------------------
# API da waitlist — copie para .env e preencha
# ---------------------------------------------------------------

PORT=4100

# Postgres do VPS. Use um banco/usuário próprios da landing; a tabela é
# isolada e não conflita com as migrations do Prisma do produto.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/praus
# PGSSL=require        # descomente em Postgres gerenciado que exige TLS

# ---------------------------------------------------------------
# Resend (https://resend.com/api-keys)
# ---------------------------------------------------------------
RESEND_API_KEY=

# ATENÇÃO AO REMETENTE:
#  - sem domínio verificado no Resend, o único FROM aceito é
#    onboarding@resend.dev, e a entrega só funciona para o e-mail
#    dono da conta Resend;
#  - com domínio verificado, use algo do próprio domínio.
MAIL_FROM=PRAUS <onboarding@resend.dev>
MAIL_TO=jumtcompetition@gmail.com

# ---------------------------------------------------------------
# Exportação dos e-mails
# ---------------------------------------------------------------
# Token do GET /api/waitlist/export (header x-export-token).
# Vazio = rota desligada. Gere com: openssl rand -hex 32
EXPORT_TOKEN=

# ---------------------------------------------------------------
# Rede
# ---------------------------------------------------------------
# Deixe VAZIO quando o nginx servir a landing e a API no mesmo domínio.
# Só preencha se o front vier de outra origem (ex.: https://praus.gg)
CORS_ORIGIN=

# Máximo de envios por IP a cada 10 minutos
RATE_LIMIT=12

# ---------------------------------------------------------------
# Vagas do beta
# ---------------------------------------------------------------
# Ao atingir esse total, a API passa a recusar novos e-mails e a landing
# pinta todos os botões de cinza com "Acessos Esgotados".
# 0 desliga o limite.
WAITLIST_LIMIT=1200
